# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# HuggingFace access token. Llama-3.1 is gated: accept the license at
# https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct before using it.
HF_TOKEN=

# Where HuggingFace caches models and datasets. Point this at a large disk
# on the GPU machine (the 8B target alone is ~16 GB).
HF_HOME=/path/to/hf_cache

# Where trained tokenizers, draft model checkpoints and distillation data go.
CKPT_DIR=/path/to/checkpoints

# Where eval outputs (generations, timing logs) are written.
RESULTS_DIR=./results

# Optional: Weights & Biases logging. Leave WANDB_MODE=disabled to turn it off.
WANDB_API_KEY=
WANDB_PROJECT=superspec
WANDB_MODE=disabled
